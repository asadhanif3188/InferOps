{
  "title": "Expected rejections for the WorkloadContract v1alpha1 invalid fixtures",
  "description": "Every file under this directory must be refused, and must be refused for exactly the reasons recorded here. The test suite compares this manifest with the validator's output field by field, so a change that alters a canonical error code, a rule identifier, or a field location fails the build instead of quietly changing what consumers are told.",
  "layers": {
    "structural": "The published JSON Schema alone refuses the document. Any draft 2020-12 validator in any language reaches the same conclusion.",
    "semantic": "The published JSON Schema alone ACCEPTS the document. It is refused only by the rules JSON Schema cannot express, which ADR 0003 placed in a validation layer above the schema. These fixtures are the evidence that the layer is load-bearing rather than decorative."
  },
  "fixtures": {
    "duplicate-secret-ref-name.yaml": {
      "layer": "semantic",
      "expected": [
        {
          "code": "contract-invalid",
          "rule": "secret-ref-name-duplicated",
          "field": "$.spec.security.secretRefs[1].name"
        }
      ]
    },
    "malformed-identifiers.yaml": {
      "layer": "structural",
      "expected": [
        {
          "code": "contract-invalid",
          "rule": "value-malformed",
          "field": "$.metadata.annotations.unnamespaced-key"
        },
        {
          "code": "contract-invalid",
          "rule": "value-malformed",
          "field": "$.metadata.name"
        },
        {
          "code": "contract-invalid",
          "rule": "value-not-permitted",
          "field": "$.metadata.version"
        },
        {
          "code": "contract-invalid",
          "rule": "value-malformed",
          "field": "$.spec.attribution.tenant"
        }
      ]
    },
    "missing-owner.yaml": {
      "layer": "structural",
      "expected": [
        {
          "code": "contract-invalid",
          "rule": "field-required",
          "field": "$.metadata.owner"
        }
      ]
    },
    "model-artifact-format-unrecognised.yaml": {
      "layer": "semantic",
      "expected": [
        {
          "code": "contract-invalid",
          "rule": "model-artifact-format-unknown",
          "field": "$.spec.synchronousLlm.modelArtifact.file"
        }
      ]
    },
    "mock-presented-as-real.yaml": {
      "layer": "structural",
      "expected": [
        {
          "code": "contract-invalid",
          "rule": "value-not-permitted",
          "field": "$.spec.environment"
        },
        {
          "code": "contract-invalid",
          "rule": "value-out-of-range",
          "field": "$.spec.evidence.proofRefs"
        },
        {
          "code": "contract-invalid",
          "rule": "value-not-permitted",
          "field": "$.spec.model.servingCapability"
        },
        {
          "code": "contract-invalid",
          "rule": "value-not-permitted",
          "field": "$.spec.resources.accelerator.count"
        },
        {
          "code": "contract-invalid",
          "rule": "value-not-permitted",
          "field": "$.spec.resources.accelerator.type"
        }
      ]
    },
    "mock-with-secret-refs.yaml": {
      "layer": "semantic",
      "expected": [
        {
          "code": "contract-invalid",
