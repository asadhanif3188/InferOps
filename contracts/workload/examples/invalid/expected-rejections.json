        }
      ]
    },
    "owner-not-dns-safe.yaml": {
      "layer": "structural",
      "expected": [
        {
          "code": "contract-invalid",
          "rule": "value-malformed",
          "field": "$.metadata.owner"
        }
      ]
    },
    "replica-range-inverted.yaml": {
