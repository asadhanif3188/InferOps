# Normalise stored line endings so that a diff never turns into a whole-file
# rewrite because two contributors are on different platforms.
* text=auto

# Shell scripts must be checked out with LF on every platform. A CRLF line
# ending after the shebang is part of the interpreter path, so a script checked
# out with CRLF on Windows fails to run at all. This is correctness, not style.
*.sh text eol=lf

# uv writes the lockfile with LF on every platform. Without this, a Windows
# checkout receives CRLF and the next `uv lock` rewrites the whole file, which
# turns a no-op into a diff.
uv.lock text eol=lf

# A workflow's `run:` blocks are shell scripts that a Linux runner executes, and
# a CRLF line ending inside one becomes a literal carriage return in the command
# — the same failure `*.sh` above is protected from, in a file that does not look
# like a script. `text=auto` already normalises what is stored; this pins what is
# checked out, so a runner cannot receive CRLF whatever the checkout did.
.github/workflows/*.yml text eol=lf
.github/workflows/*.yaml text eol=lf
