{
  "apiVersion": "inferops.io/v1alpha1",
  "kind": "V1SynchronousCompatibility",
  "metadata": {
    "name": "v1-synchronous-compatibility",
    "registeredBy": "V2-S2-003-PR1",
    "evidenceLevel": "C0",
    "amendedBy": [
      "V2-S2-004-PR1",
      "V2-S4-001-PR1",
      "V2-S4-002-PR1",
      "V2-S4-004-PR1"
    ]
  },
  "target": {
    "description": "The V1 real synchronous workload's values: the V1 real values file, installed over the defaults of the inferops-llm chart at its current version. That version is not the one v1.0.0 released: see releasedChartVersion and chartChangeSinceRelease.",
    "release": "v1.0.0",
    "chart": "charts/inferops-llm",
    "chartVersion": "0.6.0",
    "releasedChartVersion": "0.3.0",
    "chartChangeSinceRelease": "Chart 0.4.0 states the API Deployment's rolling-update strategy, with the bounds api.rollout holds: maxUnavailable 0 and maxSurge 1. Chart 0.5.0 states the runtime Deployment's, with the bounds runtime.rollout holds: maxUnavailable 1 and maxSurge 0. Chart 0.3.0 stated neither strategy, so the Kubernetes default applied to both Deployments. Chart 0.6.0 renders one PodDisruptionBudget for a tier of two or more replicas, and changes no value. The V1 real values file declares one replica for each tier, so it renders no budget. Rendered with the V1 real values file, 0.6.0 differs from 0.3.0 in the ten lines of the two strategies and in the chart version label.",
    "chartDefaults": "charts/inferops-llm/values.yaml",
    "valuesFile": "charts/inferops-llm/ci/real-values.yaml",
    "committedRender": "charts/inferops-llm/ci/rendered/real.expected.yaml"
  },
  "v2": {
    "description": "The same workload through the V2 render path: the generated values the reference inputs derive, and the hand-written values installed after them, admitted beside them.",
    "contract": "contracts/workload/examples/valid/synchronous-llm-local.yaml",
    "binding": "contracts/environment/examples/valid/local-kind.yaml",
    "platformDefaults": "charts/inferops-llm/values.yaml",
    "generatedRelease": "tests/domain/fixtures/helm-values/support-assistant-local-kind",
    "handWrittenValues": "tests/domain/fixtures/helm-values/support-assistant-local.manual-values.yaml"
  },
  "sources": {
    "values-file": "V1 set the value in its real values file.",
    "chart-default": "V1 set nothing; the chart's default applied."
  },
  "owners": {
    "workload-intent": "The WorkloadContract owns the value. It is claim-relevant workload intent. A generated row names the context value it renders from, or, for a derived value, the context values its rule reads.",
    "environment-binding": "The selected EnvironmentBinding owns the value.",
    "platform-defaults": "The platform defaults own the value."
  },
  "handWrittenClasses": {
    "platform-component": "The platform's own API image. It is a contributor's local build that no registry publishes, so no input owns it yet. It is not workload intent: every workload on the platform runs the same API.",
    "model-acquisition": "How the model cache is filled: whether the acquisition job runs, and how it fetches. The download location is not in this class: the renderer derives it from the contract's pins. The generated model.artifact.sha256 decides which bytes the acquisition accepts.",
    "model-metadata": "Facts about the artifact that no contract field determines: its licence identifier, and the name the runtime serves it under. The licence reference is derived from the contract's pins and is generated. Callers name the model by the generated model.identifier.",
    "host-operation": "How the release runs and checks itself on the host: pull policies, the cache mount, start-time verification, and whether its own collector runs."
  },
