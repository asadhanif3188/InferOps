  "drills": [
    {
      "command": "uv run --locked python -m tools.inference_alerts",
      "what": "The alert record, and so every runbook link it carries, satisfies the alert policy"
    },
    {
      "command": "uv run --locked python -m tools.telemetry_collection charts/inferops-llm/ci/rendered",
      "what": "The committed scrape configuration agrees with the telemetry catalog"
    },
    {
      "command": "uv run --locked python -m tools.model_acquisition check",
      "what": "The offline model prerequisites and the workspace cache state"
    },
    {
      "command": "uv run --locked python -m tools.llm_load check",
      "what": "The load profile validates without sending anything"
    },
    {
      "command": "uv run --locked python -m tools.llm_load rehearse",
      "what": "The whole load tool against an in-process stub, labelled synthetic"
    },
    {
      "command": "scripts/environment/performance-scenarios.sh check",
      "what": "The performance matrix descriptor validates without contacting anything"
    },
    {
      "command": "uv run --locked python -m tools.cost_baseline verify --record-dir docs/proof/serving --record-prefix v1-s4-004-pr1- --dir docs/proof/cost --prefix v1-s4-005-pr2-",
      "what": "The committed cost baseline regenerates byte for byte"
    },
    {
      "command": "uv run --locked python -m tools.cost_calculation verify --input tests/cost/fixtures/cost-calculation/estimate-closes.input.json --result tests/cost/fixtures/cost-calculation/estimate-closes.result.json",
      "what": "A committed cost calculation regenerates byte for byte"
    },
    {
      "command": "uv run --locked python -m pytest tests/cost -q",
      "what": "The cost suite"
    }
  ],
  "notDrilled": [
    "Every command that contacts a cluster. No cluster run was authorised for this change, and the container engine was not running on the host when it was validated.",
    "Every mutating and destructive command on the page.",
    "scripts/environment/preflight.sh, which needs a running engine to answer.",
    "Following any incident procedure from the page end to end."
  ],
  "gaps": [
    "No installed release evaluates the six alerts: the release's collector loads the recording rules and not the alert rule files, and nothing routes an alert to anybody.",
    "No restart, memory, or model-readiness alert exists, and no partial-error alert, because the signals are not emitted or no error budget is decided.",
    "A disruption shorter than an alert window is invisible by design, and the recorded pod loss was one.",
    "No automated rollback, and no script that installs a release and leaves it running.",
    "Resource pressure, out-of-memory, a telemetry gap, and a cost anomaly have never been provoked. Their procedures are described."
  ],
  "limitations": [
    "Every executed result behind the runbook is one provider's, docker-desktop, on one Windows host, CPU only, with one replica of each tier.",
    "A workflow having executed a command is not an operator having followed the procedure. Nobody other than the author has followed the page.",
    "No figure quoted is an availability figure, a service-level objective, an error budget, or a recovery-time objective."
  ]
