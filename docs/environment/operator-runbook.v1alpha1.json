  "target": {
    "provider": "docker-desktop",
    "context": "docker-desktop",
    "kubeconfig": ".kube/inferops-target.config",
    "namespace": "inferops-release",
    "release": "inferops",
    "note": "The reference provider. On kind the context is kind- followed by the cluster name and nothing else changes. Every value is compared against scripts/environment/lib.sh."
  },
  "recoveryKinds": [
    {
      "kindId": "automatic",
      "meaning": "A controller already running in the cluster restores service with nobody acting. It does not mean anybody is told."
    },
    {
      "kindId": "partial",
      "meaning": "A controller restarts or replaces something, and that is not the same as restoring what was lost."
    },
    {
      "kindId": "none",
      "meaning": "Nothing recovers it. A person has to act."
    }
  ],
